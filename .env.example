# Configure estes valores no Render.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Opção recomendada: Supabase Free, sem disco no Render.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Use a chave service_role legada JWT somente no servidor, nunca no aplicativo.

# Alternativa para instalações que já possuam disco persistente:
# SAFRATAB_TRIAL_DB_PATH=/var/data/safratab/trials.sqlite

# Opcional: autoriza o piloto SAFRAMOR no mesmo servidor e com a mesma OpenAI.
# Use um código privado aleatório de 16 a 512 caracteres, sem espaços nas pontas.
SAFRAMOR_ACCESS_CODE=
